# SignalDesk Web Client Environment Variables
# Copy this file to .env.local and configure your credentials.
# NEVER commit .env.local or secret keys to git.

# 1. Firebase Client Configuration (Firebase Console > Project Settings > General > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# 2. Google OAuth Client ID (Optional for Google Sign-In)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 3. Python FastAPI Quantitative Engine Endpoint
NEXT_PUBLIC_ENGINE_URL=http://localhost:8000
